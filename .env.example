# PlacePrep AI frontend — environment template.
# Copy to `.env.local` for local development. `.env.local` is gitignored.
# Everything prefixed VITE_ is bundled into the browser: NEVER put secrets here.
# In production set these in Vercel → Project → Settings → Environment Variables.

# [required in production] Backend base URL including the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: n8n/assistant webhook for the help chatbot. Widget is hidden when empty.
VITE_CHATBOT_WEBHOOK_URL=

# Optional: Sentry DSN for browser error reporting.
VITE_SENTRY_DSN=
